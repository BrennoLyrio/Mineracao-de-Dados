		<properties node_id="6" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\t\xaf\x00\x00\x00\xbf\x00\x00\x0c\xd0\x00\x00\x030\x00\x00\t\xb0\x00\x00\x00\xd8\x00\x00\x0c\xcf\x00\x00\x03/\x00\x00\x00\x01\x00\x00\x00\x00\x07\x80\x00\x00\t\xb0\x00\x00\x00\xd8\x00\x00\x0c\xcf\x00\x00\x03/', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': "from Orange.data.pandas_compat import table_to_frame, table_from_frame\nimport pandas as pd\n\ndf = table_to_frame(in_data, include_metas=True)\n\ndf['Ano_Nascimento'] = pd.to_datetime(df['Data_Nascimento'], dayfirst=True).dt.year\ndf['Ano_Esperado'] = 2024 - df['Idade'].astype(int)\ndf['Diferenca_Anos'] = abs(df['Ano_Nascimento'] - df['Ano_Esperado'])\n\ninconsistentes = df[df['Diferenca_Anos'] &gt; 1]\nprint(inconsistentes[['ID_Cliente','Idade','Ano_Esperado','Ano_Nascimento','Diferenca_Anos']])\n\nout_data = table_from_frame(inconsistentes)", 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
